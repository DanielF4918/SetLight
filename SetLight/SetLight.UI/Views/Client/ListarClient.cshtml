@model IEnumerable<SetLight.Abstracciones.ModelosParaUI.ClientDto>

@{
    ViewBag.Title = "Clientes";
}

<div class="container-inventario">
    <h2 class="titulo-inventario">Clientes</h2>

    @using (Html.BeginForm("ListarClient", "Client", FormMethod.Get))
    {
        <div class="row filtro-inventario mb-4">
            <div class="col-md-3">
                <label class="form-label">Nombre completo</label>
                <input type="text" name="nombre" value="@ViewBag.NombreBuscado" class="form-control" placeholder="Ej: Daniel Fuentes" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Teléfono</label>
                <input type="text" name="telefono" value="@ViewBag.TelefonoBuscado" class="form-control" placeholder="Ej: 8888-8888" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Correo</label>
                <input type="text" name="correo" value="@ViewBag.CorreoBuscado" class="form-control" placeholder="Ej: correo@ejemplo.com" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Estado</label>
                @Html.DropDownList("status", (IEnumerable<SelectListItem>)ViewBag.Estados, "Todos", new { @class = "form-control" })
            </div>

            <div class="col-md-1 d-flex align-items-end">
                <input type="submit" value="Filtrar" class="btn btn-dark btn-sm w-100" />
            </div>
        </div>
    }

    <div class="mb-3">
        @Html.ActionLink("+ Registrar nuevo cliente", "Create", null, new { @class = "btn btn-success btn-sm mb-3" })
    </div>

    <table class="table table-striped table-bordered tabla-inventario">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th>Estado</th>
                <th colspan="2" class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FirstName @item.LastName</td>
                    <td>@item.Phone</td>
                    <td>@item.Email</td>
                    <td>@item.EstadoEnTexto</td>
                    <td class="acciones text-nowrap">
                        @if (item.Status == 1)
                        {
                            @Html.ActionLink("Inactivar", "Inactivar", new { id = item.ClientId }, new { @class = "btn btn-warning btn-sm" })
                        }
                        else
                        {
                            @Html.ActionLink("Activar", "Activar", new { id = item.ClientId }, new { @class = "btn btn-success btn-sm" })
                        }
                    </td>
                    <td class="acciones text-nowrap">
                        @Html.ActionLink("Editar", "Edit", "Client", new { id = item.ClientId }, new { @class = "btn btn-dark btn-sm me-1" })
                        @Html.ActionLink("Historial", "History", "RentalOrder", new { clientId = item.ClientId }, new { @class = "btn btn-info btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
