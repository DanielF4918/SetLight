@model IEnumerable<SetLight.Abstracciones.ModelosParaUI.ClientDto>

@{
    ViewBag.Title = "Clientes";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-black">Clientes</h2>
        @Html.ActionLink("+ Registrar nuevo cliente", "Create", null, new { @class = "btn btn-danger text-white fw-semibold" })
    </div>

    @using (Html.BeginForm("ListarClient", "Client", FormMethod.Get))
    {
        <div class="row g-3 align-items-end mb-4">
            <div class="col-md-3">
                <label class="form-label text-black">Nombre completo</label>
                <input type="text" name="nombre" value="@ViewBag.NombreBuscado" class="form-control border-dark" placeholder="Ej: Daniel Fuentes" />
            </div>
            <div class="col-md-3">
                <label class="form-label text-black">Teléfono</label>
                <input type="text" name="telefono" value="@ViewBag.TelefonoBuscado" class="form-control border-dark" placeholder="Ej: 8888-8888" />
            </div>
            <div class="col-md-3">
                <label class="form-label text-black">Correo</label>
                <input type="text" name="correo" value="@ViewBag.CorreoBuscado" class="form-control border-dark" placeholder="Ej: correo@ejemplo.com" />
            </div>
            <div class="col-md-2">
                <label class="form-label text-black">Estado</label>
                @Html.DropDownList("status", (IEnumerable<SelectListItem>)ViewBag.Estados, "Todos", new { @class = "form-control border-dark" })
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-dark w-100">Filtrar</button>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="styled-table align-middle text-center w-100">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Estado</th>
                    <th colspan="2">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FirstName @item.LastName</td>
                        <td>@item.Phone</td>
                        <td>@item.Email</td>
                        <td>@item.EstadoEnTexto</td>
                        <td>
                            @if (item.Status == 1)
                            {
                                @Html.ActionLink("Inactivar", "Inactivar", new { id = item.ClientId }, new { @class = "btn btn-dark" })
                            }
                            else
                            {
                                @Html.ActionLink("Activar", "Activar", new { id = item.ClientId }, new { @class = "btn btn-success" })
                            }
                        </td>
                        <td>
                            @Html.ActionLink("Editar", "Edit", "Client", new { id = item.ClientId }, new { @class = "btn btn-secondary me-1" })
                            @Html.ActionLink("Historial", "History", "RentalOrder", new { clientId = item.ClientId }, new { @class = "btn btn-danger" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
