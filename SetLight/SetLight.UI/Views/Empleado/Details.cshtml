@model SetLight.Abstracciones.ModelosParaUI.EmpleadoDto
@{
    ViewBag.Title = "Detalles del Empleado";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4">Detalles del Empleado</h2>

    <div class="card shadow-sm p-4 bg-light">
        <dl class="row">
            <dt class="col-sm-3">Cédula</dt>
            <dd class="col-sm-9">@Model.Cedula</dd>

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">Apellido</dt>
            <dd class="col-sm-9">@Model.Apellido</dd>

            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@Model.TelefonoCelular</dd>

            <dt class="col-sm-3">Correo</dt>
            <dd class="col-sm-9">@Model.CorreoElectronico</dd>

            <dt class="col-sm-3">Rol</dt>
            <dd class="col-sm-9">@((string.IsNullOrWhiteSpace(Model.NombreRol) ? Model.RolId : Model.NombreRol))</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                @if (Model.Estado)
                {<span class="badge bg-success">Activo</span> }
                else
                { <span class="badge bg-secondary">Inactivo</span>}
            </dd>

            <hr />

            <dt class="col-sm-3">Contacto Emergencia</dt>
            <dd class="col-sm-9">
                <div><strong>Nombre:</strong> @Model.ContactoEmergenciaNombre</div>
                <div><strong>Teléfono:</strong> @Model.ContactoEmergenciaTelefono</div>
                <div><strong>Parentesco:</strong> @Model.ContactoEmergenciaParentesco</div>
            </dd>

            <dt class="col-sm-3">Información Médica</dt>
            <dd class="col-sm-9">
                <div><strong>Tipo de sangre:</strong> @Model.TipoSangre</div>
                <div><strong>Alergias:</strong> @Model.Alergias</div>
                <div><strong>Notas médicas:</strong> @Model.InfoMedica</div>
            </dd>

            <dt class="col-sm-3">Id Interno (GUID)</dt>
            <dd class="col-sm-9"><code>@Model.IdEmpleadoGuid</code></dd>
        </dl>

        <div class="mt-3">
            @Html.ActionLink("Editar", "Edit", new { id = Model.IdEmpleado }, new { @class = "btn btn-warning me-2" })
            @Html.ActionLink("Volver al listado", "ListarEmpleado", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
</div>
