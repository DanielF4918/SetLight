@model SetLight.Abstracciones.ModelosParaUI.EmpleadoDto

@{
    ViewBag.Title = "Crear Empleado";
}

<h2 class="mb-4">Registrar nuevo empleado</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="card shadow-sm p-4 bg-light">
        <h4 class="mb-3">Formulario de registro</h4>
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        @Html.HiddenFor(model => model.IdEmpleadoGuid)

        <div class="mb-3">
            @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.Apellido, htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.Apellido, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Apellido, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.TelefonoCelular, htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.TelefonoCelular, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.TelefonoCelular, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.CorreoElectronico, htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.CorreoElectronico, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.CorreoElectronico, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.RolId, htmlAttributes: new { @class = "form-label" })
            @Html.DropDownListFor(model => model.RolId, (IEnumerable<SelectListItem>)ViewBag.Roles, "Seleccione un rol", new { @class = "form-select" })
            @Html.ValidationMessageFor(model => model.RolId, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3 form-check">
            @Html.EditorFor(model => model.Estado, new { htmlAttributes = new { @class = "form-check-input" } })
            @Html.LabelFor(model => model.Estado, htmlAttributes: new { @class = "form-check-label" })
            @Html.ValidationMessageFor(model => model.Estado, "", new { @class = "text-danger" })
        </div>

        <div class="d-flex justify-content-start mt-4">
            <input type="submit" value="Registrar" class="btn btn-success me-2" />
            @Html.ActionLink("Volver a la lista", "ListarEmpleado", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
}
