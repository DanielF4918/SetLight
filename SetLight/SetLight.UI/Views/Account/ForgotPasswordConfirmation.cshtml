@{
    ViewBag.Title = "Correo enviado";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">

            <h2 class="mb-3">@ViewBag.Title</h2>

            <p class="lead">
                Si el correo ingresado está registrado en el sistema,
                hemos enviado un enlace para restablecer tu contraseña.
            </p>

            <p class="text-muted">
                Revisa tu bandeja de entrada y también la carpeta de spam o correo no deseado.
            </p>

            @Html.ActionLink("Volver al inicio de sesión", "Login", "Account", null, new { @class = "btn btn-dark mt-3" })
        </div>
    </div>
</div>
