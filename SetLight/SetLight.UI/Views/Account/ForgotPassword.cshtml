@model SetLight.UI.Models.ForgotPasswordViewModel

@{
    ViewBag.Title = "Recuperar contraseña";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <h2 class="mb-3 text-center">@ViewBag.Title</h2>
            <p class="text-muted text-center">
                Ingrese el correo electrónico con el que está registrado en el sistema.
                Le enviaremos un enlace para restablecer su contraseña.
            </p>

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary("", new { @class = "text-danger mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "ejemplo@correo.com" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-dark w-100">
                    Enviar enlace de recuperación
                </button>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
