@model IEnumerable<SetLight.Abstracciones.ModelosParaUI.EquipmentDto>
@using System.Globalization
@{
    ViewBag.Title = "Equipos";
    var us = CultureInfo.GetCultureInfo("en-US"); // USD

    Func<string, string> Src = (url) =>
    {
        var placeholder = Url.Content("~/content/img/placeholder-equipment.png");
        if (string.IsNullOrWhiteSpace(url)) return placeholder;
        return url.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? url : Url.Content(url);
    };

    Func<int, IHtmlString> BadgeEstado = (estado) =>
    {
        var texto = "Desconocido"; var cls = "badge bg-secondary";
        switch (estado)
        {
            case 1: texto = "Activo"; cls = "badge bg-success"; break;
            case 2: texto = "Alquilado"; cls = "badge bg-primary"; break;
            case 3: texto = "Inactivo"; cls = "badge bg-secondary"; break;
            case 4: texto = "Mantenimiento"; cls = "badge bg-warning text-dark"; break;
        }
        return new HtmlString($"<span class=\"{cls}\">{texto}</span>");
    };
}

<div class="contenido-principal">
    <div class="contenido-card">
        <div class="header-seccion d-flex justify-content-between align-items-center">
            <h2>Gestión de Equipos</h2>
            @Html.ActionLink("+ Registrar nuevo equipo", "CrearEquipment", null, new { @class = "btn btn-success btn-sm" })
        </div>

        @using (Html.BeginForm("ListarEquipment", "Equipment", FormMethod.Get))
        {
            <div class="filtros-inventario">
                <div class="filtro-item">
                    <label>Nombre del equipo</label>
                    <input type="text" name="Nombre" class="form-control" value="@ViewBag.NombreBuscado" placeholder="Canon, Sony..." />
                </div>
                <div class="filtro-item">
                    <label>Tipo</label>
                    @Html.DropDownList("CategoriaId", (IEnumerable<SelectListItem>)ViewBag.Categorias, "Todos", new { @class = "form-control" })
                </div>
                <div class="filtro-item">
                    <label>Estado</label>
                    @Html.DropDownList("Estado", (IEnumerable<SelectListItem>)ViewBag.Estados, "Todos", new { @class = "form-control" })
                </div>
                <div class="filtro-item boton-filtrar">
                    <button type="submit" class="btn btn-dark btn-sm">Filtrar</button>
                </div>
            </div>
        }

        <div class="tabla-scroll">
            <table class="table-inventario">
                <thead>
                    <tr>
                        <th style="width:70px">Imagen</th>
                        <th>Equipo</th>
                        <th>Serie</th>
                        <th>Descripción</th>
                        <th>Alquiler</th>
                        <th>Disponibles</th>
                        <th>Alquilados</th>
                        <th>Mantenimiento</th>
                        <th>Estado</th>
                        <th>Categoría</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@Src(item.ImageUrl)" alt="img @item.EquipmentName"
                                         style="width:56px;height:56px;object-fit:cover;border-radius:8px;" />
                                </td>
                                <td>@item.EquipoCompleto</td>
                                <td>@item.SerialNumber</td>
                                <td>@item.Description</td>
                                <td>@item.RentalValue.ToString("C2", us)</td>
                                <td>@item.Disponibles</td>
                                <td>@item.Alquilados</td>
                                <td>
                                    @if (item.EnMantenimiento > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@item.EnMantenimiento</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">0</span>
                                    }
                                </td>

                                <td>@BadgeEstado(item.Status)</td>
                                <td>@item.CategoriaNombre</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (item.Status == 1)
                                        {
                                            @Html.ActionLink("Inactivar", "Inactivar", new { id = item.EquipmentId }, new { @class = "btn btn-eliminar btn-sm" })
                                        }
                                        else
                                        {
                                            @Html.ActionLink("Activar", "Activar", new { id = item.EquipmentId }, new { @class = "btn btn-success btn-sm" })
                                        }

                                        @Html.ActionLink("Editar", "Edit", new { id = item.EquipmentId }, new { @class = "btn-editar btn-sm" })
                                        @Html.ActionLink("Trazabilidad", "VerTrazabilidad", "Trazabilidad", new { equipoId = item.EquipmentId }, new { @class = "btn-trazabilidad btn-sm" })
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted">No hay equipos para mostrar.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
