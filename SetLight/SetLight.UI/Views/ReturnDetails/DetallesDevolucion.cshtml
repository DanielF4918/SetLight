@model List<SetLight.Abstracciones.ModelosParaUI.ReturnDetailsDto>

@{
    ViewBag.Title = "Detalles de Devolución";
}

<h2>Detalles de Devolución - Orden @ViewBag.OrderId</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay devoluciones registradas para esta orden.</div>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Equipo</th>
                <th>Fecha de Devolución</th>
                <th>¿Devuelto?</th>
                <th>¿Requiere Mantenimiento?</th>
                <th>Observaciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EquipmentName</td>
                    <td>@item.ReturnDate.ToShortDateString()</td>
                    <td>@(item.IsReturned ? "Sí" : "No")</td>
                    <td>@(item.RequiresMaintenance ? "Sí" : "No")</td>
                    <td>@item.ConditionReport</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    @Html.ActionLink("Volver al listado de órdenes", "Index", "RentalOrder", null, new { @class = "btn btn-secondary" })
</div>
