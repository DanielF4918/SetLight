@model SetLight.Entidades.Maintenance

<h2>Finalizar mantenimiento</h2>

@using (Html.BeginForm("FinalizarMantenimiento", "ReturnDetails", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    @Html.Hidden("id", Model.MaintenanceId)
    @Html.HiddenFor(m => m.MaintenanceId)

    <div class="form-group">
        <label>Equipo:</label>
        <p>@Model.Equipment?.EquipmentName</p>
    </div>

    <div class="form-group">
        <label>Comentarios:</label>
        @Html.TextArea("comments", null, new { @class = "form-control", rows = 3 })
    </div>

    <div class="form-group">
        <label>Costo:</label>
        @Html.TextBox("cost", null, new { @class = "form-control", type = "number", step = "0.01" })
    </div>

    <div class="form-group">
        <label>Evidencia (opcional):</label>
        <input type="file" name="evidenceFile" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Guardar y Finalizar</button>
}
