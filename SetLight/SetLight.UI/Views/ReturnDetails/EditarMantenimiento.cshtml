@model SetLight.Entidades.Maintenance

@{
    ViewBag.Title = "Editar Mantenimiento";
}

<h2>Editar mantenimiento finalizado</h2>

@using (Html.BeginForm("EditarMantenimiento", "ReturnDetails", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MaintenanceId)

    <div class="form-group">
        <label>Equipo:</label>
        <p class="form-control-static">@Model.Equipment?.EquipmentName</p>
    </div>

    <div class="form-group">
        <label>Comentarios:</label>
        @Html.TextArea("comments", Model.Comments, new { @class = "form-control", rows = 3 })
    </div>

    <div class="form-group">
        <label>Costo (₡):</label>
        @Html.TextBox("cost", Model.Cost?.ToString("N2"), new { @class = "form-control", type = "number", step = "0.01" })
    </div>

    <div class="form-group">
        <label>Evidencia actual:</label><br />
        @if (!string.IsNullOrEmpty(Model.EvidencePath))
        {
            var extension = System.IO.Path.GetExtension(Model.EvidencePath).ToLower();
            if (extension == ".jpg" || extension == ".jpeg" || extension == ".png" || extension == ".gif" || extension == ".webp")
            {
                <img src="@Url.Content(Model.EvidencePath)" alt="Evidencia" class="img-thumbnail" style="max-width: 300px;" />
            }
            else
            {
                <a href="@Url.Content(Model.EvidencePath)" target="_blank">Ver archivo actual</a>
            }
        }
        else
        {
            <span>— Sin evidencia —</span>
        }
    </div>

    <div class="form-group">
        <label>Reemplazar evidencia:</label>
        <input type="file" name="evidenceFile" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    @Html.ActionLink("Cancelar", "Mantenimientos", "ReturnDetails", null, new { @class = "btn btn-secondary" })
}
