@model List<SetLight.Entidades.Maintenance>

@{
    ViewBag.Title = "Mantenimientos";
}

<h2 class="mb-3">Listado de Mantenimientos</h2>

<div class="mb-3">
    <form method="get">
        <input type="text" name="equipo" placeholder="Buscar equipo..." value="@ViewBag.FiltroEquipo" />
        <select name="estado">
            <option value="">-- Estado --</option>
            <option value="0" @(ViewBag.FiltroEstado == 0 ? "selected" : "")>Pendiente</option>
            <option value="1" @(ViewBag.FiltroEstado == 1 ? "selected" : "")>Finalizado</option>
        </select>
        <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="styled-table table table-striped">
    <thead>
        <tr>
            <th>Equipo</th>
            <th>Inicio</th>
            <th>Fin</th>
            <th>Tipo</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@(m.Equipment?.EquipmentName ?? "(Sin nombre)")</td>
                <td>@m.StartDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @(m.EndDate.HasValue ? m.EndDate.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                </td>
                <td>
                    @(
                        m.MaintenanceType == 1 ? "Revisión por daño" :
                        m.MaintenanceType == 2 ? "Reparación mayor" :
                        m.MaintenanceType == 3 ? "Mantenimiento preventivo" :
                        "—"
                    )
                </td>
                <td>
                    @if (m.MaintenanceStatus == 0)
                    {
                        <span class="badge bg-warning text-dark">Pendiente</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Finalizado</span>
                    }
                </td>
                <td>
                    @if (m.MaintenanceStatus == 0)
                    {
                        @Html.ActionLink("Finalizar", "Finalize", "ReturnDetails", new { id = m.MaintenanceId }, new { @class = "btn btn-success btn-sm" })
                    }
                    else
                    {
                        @Html.ActionLink("Ver detalles", "DetallesMantenimiento", "ReturnDetails", new { id = m.MaintenanceId }, new { @class = "btn btn-info btn-sm me-2" })
                        @Html.ActionLink("Editar", "EditarMantenimiento", "ReturnDetails", new { id = m.MaintenanceId }, new { @class = "btn btn-warning btn-sm" })
                    }
                </td>

            </tr>
        }
    </tbody>
</table>

<style>
    .styled-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
        font-size: 15px;
    }

        .styled-table th {
            background-color: #f8f9fa;
            text-align: left;
            padding: 8px;
        }

        .styled-table td {
            padding: 8px;
            vertical-align: middle;
        }

    .badge {
        font-size: 0.9rem;
    }

    form input, form select {
        margin-right: 10px;
        padding: 4px 8px;
    }
</style>
