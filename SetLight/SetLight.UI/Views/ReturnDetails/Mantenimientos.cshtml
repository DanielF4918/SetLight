@model List<SetLight.Entidades.Maintenance>

@{
    ViewBag.Title = "Mantenimientos en curso";
}

<h2>Mantenimientos</h2>

<div class="mb-3 d-flex gap-2">
    @Html.ActionLink(
        "Ver Histórico",
        "Historico",
        "ReturnDetails",
        new { area = "" },
        new { @class = "btn btn-secondary" }
    )
</div>

@using (Html.BeginForm("Mantenimientos", "ReturnDetails", FormMethod.Get))
{
    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <label>Equipo</label>
            @Html.DropDownList("equipmentId", (IEnumerable<SelectListItem>)ViewBag.Equipos, "Todos", new { @class = "form-control" })
        </div>
        <div class="col-md-3">
            <label>Estado</label>
            @Html.DropDownList("status", (IEnumerable<SelectListItem>)ViewBag.Statuses, "Todos", new { @class = "form-control" })
        </div>
        <div class="col-md-3">
            <label>Tipo</label>
            @Html.DropDownList("type", (IEnumerable<SelectListItem>)ViewBag.Types, "Todos", new { @class = "form-control" })
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-dark w-100">Filtrar</button>
        </div>
    </div>

    <div class="row g-2 mb-4">
        <div class="col-md-3">
            <label>Desde</label>
            <input type="date" name="from" class="form-control" value="@Request["from"]" />
        </div>
        <div class="col-md-3">
            <label>Hasta</label>
            <input type="date" name="to" class="form-control" value="@Request["to"]" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <a href="@Url.Action("Mantenimientos","ReturnDetails")" class="btn btn-outline-secondary w-100">Limpiar</a>
        </div>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>Equipo</th>
            <th>Inicio</th>
            <th>Tipo</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.Equipment.EquipmentName</td>
                <td>@m.StartDate.ToString("dd/MM/yyyy")</td>
                <td>
                    @{
                        var tipo = m.MaintenanceType == 1 ? "Revisión por daño"
                                 : m.MaintenanceType == 2 ? "Reparación mayor"
                                 : m.MaintenanceType == 3 ? "Mantenimiento preventivo"
                                 : "—";
                    }
                    @tipo
                </td>
                <td>@(m.MaintenanceStatus == 1 ? "En curso" : "Finalizado")</td>
                <td>
                    @if (m.MaintenanceStatus == 1)
                    {
                        using (Html.BeginForm("FinalizarMantenimiento", "ReturnDetails", FormMethod.Post))
                        {
                            @Html.Hidden("id", m.MaintenanceId)
                            <button type="submit" class="btn btn-success">Finalizar</button>
                        }
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
