@model SetLight.Entidades.Dto.MaintenanceDto

@{
    ViewBag.Title = "Editar equipo faltante";
}

<div class="container mt-4 mb-5 p-4 bg-white shadow rounded" style="max-width: 800px;">
    <h2 class="text-center mb-4 text-dark">Editar equipo faltante / no devuelto</h2>

    @using (Html.BeginForm("EditFaltante", "ReturnDetails", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.MaintenanceId)
        @Html.HiddenFor(m => m.EquipmentId)

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3">
            <label class="form-label fw-semibold">Orden</label><br />
            @if (Model.OrderId.HasValue)
            {
                @Html.ActionLink(
                    "#" + Model.OrderId.Value,
                    "DetallesDevolucion",
                    "ReturnDetails",
                    new { orderId = Model.OrderId.Value },
                    new { @class = "link-primary text-decoration-none" }
                )
            }
            else
            {
                <span class="text-muted">N/D</span>
            }
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Cliente</label>
            <input type="text" class="form-control" value="@Model.ClientName" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Equipo</label>
            <input type="text" class="form-control" value="@Model.EquipmentName" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Cantidad faltante</label>
            <input type="number" class="form-control" value="@Model.Cantidad" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Estado</label>
            @Html.DropDownListFor(
                m => m.MaintenanceStatus,
                new List<SelectListItem>
                {
                    new SelectListItem { Text = "Pendiente", Value = "0", Selected = Model.MaintenanceStatus == 0 },
                    new SelectListItem { Text = "Finalizado", Value = "1", Selected = Model.MaintenanceStatus == 1 }
                },
                new { @class = "form-control" }
            )
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Costo de reposición ($)</label>
            @Html.TextBoxFor(m => m.Cost, new { @class = "form-control", type = "number", step = "0.01", min = "0" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Comentarios</label>
            @Html.TextAreaFor(m => m.Comments,
                new { @class = "form-control", rows = "4", placeholder = "Detalle cómo se gestionó el faltante: pago del cliente, reposición, nota interna, etc." })
        </div>

        <div class="mt-4 text-center">
            <button type="submit" class="btn btn-success px-4 fw-semibold">Guardar cambios</button>
            @Html.ActionLink("Cancelar", "Faltantes", "ReturnDetails", null, new { @class = "btn btn-secondary ms-3" })
        </div>
    }
</div>
