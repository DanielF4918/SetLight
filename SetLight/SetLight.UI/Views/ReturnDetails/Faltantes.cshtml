@model List<SetLight.Entidades.Dto.MaintenanceDto>

@{
    ViewBag.Title = "Equipos faltantes";
}

<div class="container mt-4 mb-5 p-4 bg-white shadow rounded" style="max-width: 1200px;">
    <h2 class="text-center mb-4 text-dark">Equipos faltantes / no devueltos</h2>

    <div class="mb-3 text-end">
        @Html.ActionLink("Volver a mantenimientos", "Mantenimientos", "ReturnDetails", null, new { @class = "btn btn-secondary" })
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Orden</th>
                        <th>Cliente</th>
                        <th>Equipo</th>
                        <th>Cantidad faltante</th>
                        <th>Estado</th>
                        <th>Costo reposición</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (item.OrderId.HasValue)
                                {
                                    @Html.ActionLink(
                                        "#" + item.OrderId.Value,
                                        "DetallesDevolucion",
                                        "ReturnDetails",
                                        new { orderId = item.OrderId.Value },
                                        new { @class = "link-primary text-decoration-none" }
                                    )
                                }
                                else
                                {
                                    @:<span class="text-muted">N/D</span>
                                }
                            </td>


                            <td>
                                @if (!string.IsNullOrEmpty(item.ClientName))
                                {
                                    @item.ClientName
                                }
                                else
                                {
                                    @:<span class="text-muted">Desconocido</span>
                                }
                            </td>
                            <td>@item.EquipmentName</td>
                            <td>@item.Cantidad</td>
                            <td>
                                @if (item.MaintenanceStatus == 0)
                                {
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Finalizado</span>
                                }
                            </td>
                            <td>
                                @if (item.Cost.HasValue)
                                {
                                    @item.Cost.Value.ToString("C")
                                }
                                else
                                {
                                    @:<span class="text-muted">Sin definir</span>
                                }
                            </td>
                            <td>
                                @Html.ActionLink(
     "Detalles",
     "DetallesFaltante",
     "ReturnDetails",
     new { id = item.MaintenanceId },
     new { @class = "btn btn-sm btn-outline-secondary mb-1 me-1" }
 )

                                @Html.ActionLink(
                                    "Editar",
                                    "EditFaltante",
                                    "ReturnDetails",
                                    new { id = item.MaintenanceId },
                                    new { @class = "btn btn-sm btn-primary mb-1 me-1" }
                                )

                                @if (item.MaintenanceStatus == 0)
                                {
                                    using (Html.BeginForm("FinalizarFaltante", "ReturnDetails",
                                                           new { id = item.MaintenanceId },
                                                           FormMethod.Post,
                                                           new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-success"
                                                onclick="return confirm('¿Marcar este faltante como finalizado?');">
                                            Finalizar
                                        </button>
                                    }
                                }

                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No hay registros de equipos faltantes en este momento.
        </div>
    }
</div>
