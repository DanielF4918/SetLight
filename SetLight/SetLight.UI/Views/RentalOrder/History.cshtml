@using PagedList;
@using PagedList.Mvc;
@model IPagedList<SetLight.Abstracciones.ModelosParaUI.RentalOrderDto>

@{
    ViewBag.Title = "Historial de órdenes";

    Func<int, string> TextoEstado = estado =>
    {
        switch (estado)
        {
            case 1: return "Activa";
            case 2: return "Completada";
            case 3: return "Cancelada";
            default: return "Desconocido";
        }
    };
}

<h2>Historial de órdenes de @ViewBag.ClientName</h2>

<form method="get" class="row mb-3">
    <input type="hidden" name="clientId" value="@ViewBag.ClientId" />

    <div class="col-md-3">
        <label>Desde</label>
        <input type="date" name="desde" class="form-control" value="@ViewBag.FiltroDesde" />
    </div>

    <div class="col-md-3">
        <label>Hasta</label>
        <input type="date" name="hasta" class="form-control" value="@ViewBag.FiltroHasta" />
    </div>

    <div class="col-md-3 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-dark">
            <i class="bi bi-funnel me-1"></i> Filtrar
        </button>

        <a style="text-align: right"
           href="@Url.Action("History", new { clientId = ViewBag.ClientId })"
           class="btn btn-outline-secondary">
            Limpiar
        </a>
    </div>
</form>

@if (!Model.Any())
{
    <p>Este cliente no tiene órdenes registradas.</p>
}
else
{
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th># Orden</th>
                <th>Fecha de Orden</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Estado</th>
                <th>Equipos</th>
                <th>Comprobante</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.OrderDate.ToShortDateString()</td>
                    <td>@order.StartDate.ToShortDateString()</td>
                    <td>@order.EndDate.ToShortDateString()</td>
                    <td>@TextoEstado(order.StatusOrder)</td>
                    <td>
                        <button class="btn btn-sm btn-info"
                                type="button"
                                onclick="mostrarEquiposModal(@order.OrderId)">
                            Ver equipos
                        </button>
                    </td>
                    <td>
                        @if (order.StatusOrder == 1 || order.StatusOrder == 2)
                        {
                            <a href="@Url.Action("VerComprobante", "RentalOrder", new { id = order.OrderId })"
                               class="btn btn-sm btn-success">
                                Descargar comprobante
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">No disponible</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination-container text-center mt-4">
        @Html.PagedListPager(
            Model,
            page => Url.Action(
                "History",
                new
                {
                    clientId = ViewBag.ClientId,
                    page,
                    desde = ViewBag.FiltroDesde,
                    hasta = ViewBag.FiltroHasta
                }),
            new PagedListRenderOptions
            {
                DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                DisplayLinkToLastPage = PagedListDisplayMode.Always,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                DisplayLinkToIndividualPages = true,
                MaximumPageNumbersToDisplay = 10,
                UlElementClasses = new[] { "pagination-custom" }
            }
        )
    </div>

    <style>
        .pagination-custom {
            display: flex;
            justify-content: center;
            gap: 12px;
            padding: 20px 0;
        }

            .pagination-custom li {
                list-style: none;
            }

                .pagination-custom li a,
                .pagination-custom li span {
                    font-size: 20px;
                    color: black;
                    text-decoration: none;
                    padding: 4px 8px;
                }

                .pagination-custom li.active span {
                    font-weight: bold;
                }

                .pagination-custom li.disabled span {
                    color: #999;
                }
    </style>
}

@foreach (var order in Model)
{
    <div class="modal fade"
         id="modalEquipos-@order.OrderId"
         tabindex="-1"
         aria-labelledby="modalLabel-@order.OrderId"
         aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalLabel-@order.OrderId">
                        Equipos de la orden #@order.OrderId
                    </h5>
                </div>

                <div class="modal-body">
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Equipo</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Cantidad</th>
                                <th>Valor Unitario</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in order.Details)
                            {
                                <tr>
                                    <td>@detalle.EquipmentName</td>
                                    <td>@detalle.Brand</td>
                                    <td>@detalle.Model</td>
                                    <td>@detalle.Quantity</td>
                                    <td>$@detalle.RentalValue.ToString("N2")</td>
                                    <td>$@((detalle.RentalValue * detalle.Quantity).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<p>
    @Html.ActionLink(
        "Volver al listado de clientes",
        "ListarClient",
        "Client",
        null,
        new { @class = "btn btn-secondary" })
</p>

@section Scripts {
    <script src="~/Scripts/Modals/HistoryOrder/HistoryOrder.js"></script>
}
