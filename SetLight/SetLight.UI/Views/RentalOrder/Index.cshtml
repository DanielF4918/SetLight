@model List<SetLight.Abstracciones.ModelosParaUI.RentalOrderDto>

@{
    ViewBag.Title = "Órdenes de Alquiler";
}

<h2>Órdenes de Alquiler Registradas</h2>

<div class="text-right mb-3">
    @Html.ActionLink("Crear Nueva Orden", "Create", "RentalOrder", null, new { @class = "btn btn-success" })
</div>

<table class="table table-bordered table-hover">
    <thead class="thead-dark">
        <tr>
            <th># Orden</th>
            <th>Cliente</th>
            <th>Fecha Orden</th>
            <th>Inicio</th>
            <th>Fin</th>
            <th>Colaborador </th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var orden in Model)
        {
            <tr>
                <td>@orden.OrderId</td>
                <td>@orden.ClientName</td>
                <td>@orden.OrderDate.ToShortDateString()</td>
                <td>@orden.StartDate.ToShortDateString()</td>
                <td>@orden.EndDate.ToShortDateString()</td>
                <td>@orden.EmpleadoNombreCompleto</td>
                <td>
                    @{
                        string estado = orden.StatusOrder == 1 ? "Activa" :
                                        orden.StatusOrder == 2 ? "Completada" :
                                        "Cancelada";
                    }
                    @estado
                </td>
                <td>
                    <button class="btn btn-sm btn-info" type="button" onclick="mostrarEquiposModal(@orden.OrderId)">
                        Ver equipos
                    </button>

                    @if (orden.StatusOrder == 1)
                    {
                        @Html.ActionLink("Editar", "Edit", new { id = orden.OrderId }, new { @class = "btn btn-warning btn-sm" })
                        @Html.ActionLink("Registrar devolución", "CrearReturnDetails", "ReturnDetails", new { orderId = orden.OrderId }, new { @class = "btn btn-dark btn-sm" })
                    }

                    @if (orden.StatusOrder == 2)
                    {
                        @Html.ActionLink("Ver devolución", "DetallesDevolucion", "ReturnDetails", new { orderId = orden.OrderId }, new { @class = "btn btn-outline-secondary btn-sm" })
                    }
                    @if (orden.StatusOrder == 1 || orden.StatusOrder == 2)
                    {
                        <a href="@Url.Action("VerComprobante", "RentalOrder", new { id = orden.OrderId })" class="btn btn-sm btn-success">
                            Descargar comprobante
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">No disponible</span>
                    }

                </td>
            </tr>
        }
    </tbody>
</table>

@foreach (var orden in Model)
{
    <div class="modal fade" id="modalEquipos-@orden.OrderId" tabindex="-1" role="dialog" aria-labelledby="modalLabel-@orden.OrderId" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalLabel-@orden.OrderId">Equipos de la orden #@orden.OrderId</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Equipo</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Cantidad</th>
                                <th>Valor Unitario</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in orden.Details)
                            {
                                <tr>
                                    <td>@detalle.EquipmentName</td>
                                    <td>@detalle.Brand</td>
                                    <td>@detalle.Model</td>
                                    <td>@detalle.Quantity</td>
                                    <td>₡@detalle.RentalValue.ToString("N2")</td>
                                    <td>₡@(detalle.RentalValue * detalle.Quantity)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function mostrarEquiposModal(orderId) {
            $('#modalEquipos-' + orderId).modal('show');
        }
    </script>
}
