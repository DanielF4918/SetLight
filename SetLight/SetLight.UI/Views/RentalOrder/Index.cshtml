@model List<SetLight.Abstracciones.ModelosParaUI.RentalOrderDto>
@using System.Globalization
@{ ViewBag.Title = "Órdenes de Alquiler"; var us = CultureInfo.GetCultureInfo("en-US"); }

<div class="container mt-4 mb-5 bg-white p-4 shadow rounded">
    <h2 class="mb-4 text-dark fw-bold">Órdenes de Alquiler Registradas</h2>

    <div class="text-end mb-3">
        @Html.ActionLink("Crear Nueva Orden", "Create", "RentalOrder", null, new { @class = "btn btn-success" })
    </div>

    @using (Html.BeginForm("Index", "RentalOrder", FormMethod.Get))
    {
        <div class="row g-2 mb-3">
            <div class="col-md-2">
                <label># Orden</label>
                <input type="number" name="orderId" class="form-control" value="@Request["orderId"]" />
            </div>
            <div class="col-md-3">
                <label>Cliente</label>
                @Html.DropDownList("clientId", (IEnumerable<SelectListItem>)ViewBag.Clientes, "Todos", new { @class = "form-control" })
            </div>
            <div class="col-md-2">
                <label>Estado</label>
                @Html.DropDownList("status", (IEnumerable<SelectListItem>)ViewBag.Statuses, "Todos", new { @class = "form-control" })
            </div>
            <div class="col-md-3">
                <label>Colaborador</label>
                @Html.DropDownList("employeeId", (IEnumerable<SelectListItem>)ViewBag.Empleados, "Todos", new { @class = "form-control" })
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-dark w-100">Filtrar</button>
            </div>
        </div>

        <div class="row g-2 mb-4">
            <div class="col-md-3">
                <label>Desde</label>
                <input type="date" name="from" class="form-control" value="@Request["from"]" />
            </div>
            <div class="col-md-3">
                <label>Hasta</label>
                <input type="date" name="to" class="form-control" value="@Request["to"]" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a class="btn btn-outline-secondary w-100" href="@Url.Action("Index","RentalOrder")">Limpiar</a>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-hover text-center align-middle">
            <thead class="table-dark text-white">
                <tr>
                    <th># Orden</th>
                    <th>Cliente</th>
                    <th>Fecha Orden</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Colaborador</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var orden in Model)
                {
                    <tr>
                        <td>@orden.OrderId</td>
                        <td>@orden.ClientName</td>
                        <td>@orden.OrderDate.ToShortDateString()</td>
                        <td>@orden.StartDate.ToShortDateString()</td>
                        <td>@orden.EndDate.ToShortDateString()</td>
                        <td>@orden.EmpleadoNombreCompleto</td>
                        <td>
                            @{
                                string estado = orden.StatusOrder == 1 ? "Activa" :
                                                orden.StatusOrder == 2 ? "Completada" :
                                                "Cancelada";
                            }
                            @estado
                        </td>
                        <td>
                            <button class="btn btn-sm btn-dark mb-1" onclick="mostrarEquiposModal(@orden.OrderId)">
                                Ver equipos
                            </button>

                            @if (orden.StatusOrder == 1)
                            {
                                @Html.ActionLink("Editar", "Edit", new { id = orden.OrderId }, new { @class = "btn btn-warning btn-sm mb-1" })
                                @Html.ActionLink("Registrar devolución", "CrearReturnDetails", "ReturnDetails", new { orderId = orden.OrderId }, new { @class = "btn btn-secondary btn-sm mb-1" })
                            }

                            @if (orden.StatusOrder == 2)
                            {
                                @Html.ActionLink("Ver devolución", "DetallesDevolucion", "ReturnDetails", new { orderId = orden.OrderId }, new { @class = "btn btn-outline-secondary btn-sm mb-1" })
                            }

                            @if (orden.StatusOrder == 1 || orden.StatusOrder == 2)
                            {
                                <a href="@Url.Action("VerComprobante", "RentalOrder", new { id = orden.OrderId })" class="btn btn-sm btn-success mb-1">
                                    Descargar comprobante
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No disponible</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modales -->
@foreach (var orden in Model)
{
    <div class="modal fade" id="modalEquipos-@orden.OrderId" tabindex="-1" role="dialog" aria-labelledby="modalLabel-@orden.OrderId" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="modalLabel-@orden.OrderId">Equipos de la orden #@orden.OrderId</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <table class="table table-sm table-bordered text-center align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Equipo</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Cantidad</th>
                                <th>Valor Unitario</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in orden.Details)
                            {
                                <tr>
                                    <td>@detalle.EquipmentName</td>
                                    <td>@detalle.Brand</td>
                                    <td>@detalle.Model</td>
                                    <td>@detalle.Quantity</td>
                                    <td>@detalle.RentalValue.ToString("C2", us)</td>
                                    <td>@( (detalle.RentalValue * detalle.Quantity).ToString("C2", us) )</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function mostrarEquiposModal(orderId) {
            $('#modalEquipos-' + orderId).modal('show');
        }
    </script>
}
