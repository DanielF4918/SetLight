@model List<SetLight.Abstracciones.ModelosParaUI.RentalOrderDto>

@{
    ViewBag.Title = "Órdenes de Alquiler";
}

<h2>Órdenes de Alquiler Registradas</h2>

<div class="text-right mb-3">
    @Html.ActionLink("Crear Nueva Orden", "Create", "RentalOrder", null, new { @class = "btn btn-success" })
</div>

<table class="table table-bordered table-hover">
    <thead class="thead-dark">
        <tr>
            <th># Orden</th>
            <th>Cliente</th>
            <th>Fecha Orden</th>
            <th>Inicio</th>
            <th>Fin</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var orden in Model)
        {
            <tr>
                <td>@orden.OrderId</td>
                <td>@orden.ClientName</td>
                <td>@orden.OrderDate.ToShortDateString()</td>
                <td>@orden.StartDate.ToShortDateString()</td>
                <td>@orden.EndDate.ToShortDateString()</td>
                <td>
                    @{
                        string estadoTexto = orden.StatusOrder == 1 ? "Activa" :
                                             orden.StatusOrder == 2 ? "Cancelada" :
                                             orden.StatusOrder == 3 ? "Completada" : "Desconocido";
                    }
                    @estadoTexto
                </td>
                <td>
                    @Html.ActionLink("Ver Detalles", "History", new { clientId = orden.ClientId }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Editar", "Edit", new { id = orden.OrderId }, new { @class = "btn btn-warning btn-sm" })

                    @if (orden.StatusOrder == 1)
                    {
                        @Html.ActionLink("Registrar devolución", "CrearReturnDetails", "ReturnDetails", new { orderId = orden.OrderId }, new { @class = "btn btn-dark" })
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
