@model SetLight.Abstracciones.ViewModels.CrearRentalOrderViewModel

@using (Html.BeginForm())
{
    <div class="form-group">
        <label>Cliente</label><br />
        <input type="hidden" name="ClientId" id="clienteId" value="@Model.ClientId" />
        <input type="text" id="clienteNombre" class="form-control" placeholder="Seleccione un cliente..." readonly />
        <button type="button" class="btn btn-secondary mt-2" data-bs-toggle="modal" data-bs-target="#clienteModal">
            Buscar cliente
        </button>
    </div>

    <div class="form-group">
        <label>Fecha de inicio</label><br />
        @Html.TextBoxFor(m => m.StartDate, new { type = "date", @class = "form-control", id = "StartDate" })
    </div>

    <div class="form-group">
        <label>Fecha de fin</label><br />
        @Html.TextBoxFor(m => m.EndDate, new { type = "date", @class = "form-control", id = "EndDate" })
    </div>

    @Html.HiddenFor(m => m.StatusOrder)

    <!-- Campo de descuento manual (monto en colones) -->
    <div class="form-group mt-3">
        <label for="DescuentoManual">Descuento manual (₡)</label>
        @Html.TextBoxFor(m => m.DescuentoManual, new { @class = "form-control", id = "DescuentoManual", type = "number", min = "0", step = "0.01" })
    </div>

    <div class="form-group">
        <label>Equipos</label><br />
        <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#modalSeleccionarEquipos">
            Seleccionar equipos
        </button>
    </div>

    <div id="equiposSeleccionadosContainer" class="mt-3">
        <h5>Equipos seleccionados</h5>
        <table class="table table-bordered" id="tablaResumenEquipos">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Valor Renta</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

        <!-- Resumen de costos -->
        <div id="resumenCostoAlquiler" class="mt-4">
            <h5>Cálculo de alquiler</h5>
            <table class="table-inventario" style="max-width: 500px;">
                <tbody>
                    <tr>
                        <th style="width: 60%;">Días de alquiler</th>
                        <td><span id="diasAlquiler">0</span></td>
                    </tr>
                    <tr>
                        <th>Subtotal</th>
                        <td>₡<span id="subtotalAlquiler">0</span></td>
                    </tr>
                    <tr>
                        <th>Descuento aplicado</th>
                        <td>₡<span id="descuentoAplicado">0</span></td>
                    </tr>
                    <tr>
                        <th>IVA (13%)</th>
                        <td>₡<span id="ivaAlquiler">0</span></td>
                    </tr>
                    <tr style="background-color: #f5f5f5; font-weight: bold;">
                        <th>Total</th>
                        <td>₡<span id="totalAlquiler">0</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div id="inputsEquiposContainer"></div>

    <div class="form-group mt-3">
        <input type="submit" value="Crear Orden" class="btn btn-primary" />
    </div>
}

<!-- Modal de equipos -->
<div class="modal fade" id="modalSeleccionarEquipos" tabindex="-1" role="dialog" aria-labelledby="modalLabelEquipos" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLabelEquipos">Seleccionar equipos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalBodyEquipos">
                @Html.Partial("_SeleccionarEquipos", Model.EquiposDisponibles)
            </div>
        </div>
    </div>
</div>

<!-- Modal de clientes -->
<div class="modal fade" id="clienteModal" tabindex="-1" role="dialog" aria-labelledby="clienteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="clienteModalLabel">Seleccionar Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="contenedorClientes">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Modals/CreateOrder/CreateOrder.js"></script>
    <script src="~/Scripts/Modals/CreateOrder/AgregarCliente.js"></script>
}
