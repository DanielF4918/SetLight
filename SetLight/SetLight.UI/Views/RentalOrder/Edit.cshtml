
@model SetLight.Abstracciones.ViewModels.CrearRentalOrderViewModel

@{
    ViewBag.Title = "Editar Orden";
}

<h2>Editar Orden</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(model => model.ClientId)
        @Html.DropDownListFor(m => m.ClientId, new SelectList(Model.Clientes, "ClientId", "FirstName"), "Seleccione un cliente", new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.StartDate)
        @Html.TextBox("StartDate", Model.StartDate.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date", id = "StartDate" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.EndDate)
        @Html.TextBox("EndDate", Model.EndDate.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date", id = "EndDate" })
    </div>

    <div class="form-group">
        <label>Descuento manual (%)</label>
        <input type="number" name="DescuentoManual" id="DescuentoManual" step="0.01" min="0" max="100" class="form-control"
               value="@(Model.DescuentoManual.HasValue ? Model.DescuentoManual.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "")" />
    </div>

    <div class="form-group">
        <label>Equipos</label><br />
        <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#modalSeleccionarEquipos">
            Seleccionar equipos
        </button>
    </div>

    <div id="inputsEquiposContainer"></div>

    <div id="equiposSeleccionadosContainer" class="mt-3">
        <h5>Equipos seleccionados</h5>
        <table class="table table-bordered" id="tablaResumenEquipos">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Valor Renta</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.EquiposSeleccionados.Count; i++)
                {
                    var equipo = Model.EquiposSeleccionados[i];
                    var subtotalEquipo = equipo.Quantity * equipo.RentalValue;

                    <tr>
                        <td>@equipo.EquipmentName</td>
                        <td>@equipo.Brand</td>
                        <td>@equipo.Model</td>
                        <td>₡@equipo.RentalValue.ToString("N2")</td>
                        <td>@equipo.Quantity</td>
                        <td>₡@subtotalEquipo.ToString("N2")</td>
                    </tr>

                    @Html.Hidden($"EquiposSeleccionados[{i}].EquipmentId", equipo.EquipmentId)
                    @Html.Hidden($"EquiposSeleccionados[{i}].EquipmentName", equipo.EquipmentName)
                    @Html.Hidden($"EquiposSeleccionados[{i}].Brand", equipo.Brand)
                    @Html.Hidden($"EquiposSeleccionados[{i}].Model", equipo.Model)
                    @Html.Hidden($"EquiposSeleccionados[{i}].RentalValue", equipo.RentalValue)
                    @Html.Hidden($"EquiposSeleccionados[{i}].Quantity", equipo.Quantity)
                }
            </tbody>
        </table>
    </div>

    <div id="resumenCostoAlquiler" class="mt-4">
        <h5>Cálculo de alquiler</h5>
        <table class="table-inventario" style="max-width: 500px;">
            <tbody>
                <tr>
                    <th style="width: 60%;">Días de alquiler</th>
                    <td><span id="diasAlquiler">0</span></td>
                </tr>
                <tr>
                    <th>Subtotal</th>
                    <td>₡<span id="subtotalAlquiler">0</span></td>
                </tr>
                <tr>
                    <th>Descuento manual</th>
                    <td>₡<span id="descuentoAplicado">0</span></td>
                </tr>
                <tr>
                    <th>IVA (13%)</th>
                    <td>₡<span id="ivaAlquiler">0</span></td>
                </tr>
                <tr style="background-color: #f5f5f5; font-weight: bold;">
                    <th>Total a pagar</th>
                    <td>₡<span id="totalAlquiler">0</span></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Guardar cambios" class="btn btn-primary" />
        @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-secondary ms-2" })
    </div>
}

<div class="modal fade" id="modalSeleccionarEquipos" tabindex="-1" role="dialog" aria-labelledby="modalLabelEquipos" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Seleccionar equipos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalBodyEquipos">
                @Html.Partial("_SeleccionarEquipos", Model.EquiposDisponibles)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Modals/EditOrder/EditOrder.js"></script>
}
