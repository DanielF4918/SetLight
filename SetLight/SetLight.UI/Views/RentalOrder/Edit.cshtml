@model SetLight.Abstracciones.ViewModels.CrearRentalOrderViewModel

@{
    ViewBag.Title = "Editar Orden";
}

<div class="container mt-4 mb-5 p-4 bg-white shadow rounded" style="max-width: 900px;">
    <h2 class="text-center mb-4 text-dark">Editar orden de alquiler</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-group mb-3">
            <label class="form-label fw-semibold">Cliente</label>
            @Html.DropDownListFor(m => m.ClientId, new SelectList(Model.Clientes, "ClientId", "FirstName", Model.ClientId), "Seleccione un cliente", new { @class = "form-control border-dark" })
        </div>

        <div class="form-group mb-3">
            <label class="form-label fw-semibold">Fecha de inicio</label>
            @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control border-dark", type = "date", id = "StartDate" })
        </div>

        <div class="form-group mb-3">
            <label class="form-label fw-semibold">Fecha de fin</label>
            @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control border-dark", type = "date", id = "EndDate" })
        </div>

        <div class="form-group mb-3">
            <label class="form-label fw-semibold">Descuento manual (%)</label>
            @Html.TextBoxFor(m => m.DescuentoManual, new { @class = "form-control border-dark", type = "number", step = "0.01", min = "0", max = "999999", id = "DescuentoManual" })
        </div>

        <div class="form-group mb-3">
            <label class="form-label fw-semibold">Equipos</label><br />
            <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#modalSeleccionarEquipos">
                Seleccionar equipos
            </button>
        </div>

        <div id="inputsEquiposContainer"></div>

        <div id="equiposSeleccionadosContainer" class="mt-4">
            <h5 class="fw-bold text-dark mb-3">Equipos seleccionados</h5>
            <div class="table-responsive">
                <table class="table table-bordered text-center align-middle" id="tablaResumenEquipos">
                    <thead class="table-dark text-white">
                        <tr>
                            <th>Nombre</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Valor Renta</th>
                            <th>Cantidad</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div id="resumenCostoAlquiler" class="mt-4">
            <h5 class="fw-bold text-dark">Cálculo de alquiler</h5>
            <table class="table table-bordered" style="max-width: 500px;">
                <tbody>
                    <tr>
                        <th style="width: 60%;">Días de alquiler</th>
                        <td><span id="diasAlquiler">0</span></td>
                    </tr>
                    <tr>
                        <th>Subtotal</th>
                        <td>$<span id="subtotalAlquiler">0</span></td>
                    </tr>
                    <tr>
                        <th>Descuento manual</th>
                        <td>$<span id="descuentoAplicado">0</span></td>
                    </tr>
                    <tr>
                        <th>IVA (13%)</th>
                        <td>$<span id="ivaAlquiler">0</span></td>
                    </tr>
                    <tr class="fw-bold bg-light">
                        <th>Total a pagar</th>
                        <td>$<span id="totalAlquiler">0</span></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="form-group mt-4 text-center">
            <input type="submit" value="Guardar cambios" class="btn btn-success px-4 fw-semibold" />
            @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-secondary ms-3" })
        </div>
    }
</div>

<div class="modal fade" id="modalSeleccionarEquipos" tabindex="-1" role="dialog" aria-labelledby="modalLabelEquipos" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalLabelEquipos">Seleccionar equipos</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalBodyEquipos">
                @Html.Partial("_SeleccionarEquipos", Model.EquiposDisponibles)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Modals/EditOrder/EditOrder.js"></script>
}
