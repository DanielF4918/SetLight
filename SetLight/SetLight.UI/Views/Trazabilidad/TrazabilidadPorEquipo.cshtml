@using PagedList
@using PagedList.Mvc
@model IPagedList<SetLight.Abstracciones.ModelosParaUI.TrazabilidadDto>



@{
    ViewBag.Title = "Trazabilidad del Equipo";
}



<div class="container mt-4 mb-5 bg-white p-4 shadow rounded">
    <h2 class="mb-4 text-dark fw-bold">
        Trazabilidad del Equipo <span class="text-secondary">#@ViewBag.EquipoId</span>
    </h2>
    <form method="get" class="row mb-4">
        <input type="hidden" name="equipoId" value="@ViewBag.EquipoId" />

        <div class="col-md-3">
            <label>Desde</label>
            <input type="date" name="desde" class="form-control" value="@ViewBag.FiltroDesde" />
        </div>

        <div class="col-md-3">
            <label>Hasta</label>
            <input type="date" name="hasta" class="form-control" value="@ViewBag.FiltroHasta" />
        </div>

        <div class="col-md-3 d-flex align-items-end gap-2">
            <button class="btn btn-dark">Filtrar</button>
        
            <a href="@Url.Action("VerTrazabilidad", new { equipoId = ViewBag.EquipoId, page = 1 })"
               class="btn btn-outline-secondary">
                Limpiar
            </a>
        </div>
    </form>

    <div class="mb-3 text-end">
        <a href="@Url.Action("DescargarTrazabilidad", "Trazabilidad", new { equipoId = ViewBag.EquipoId })"
           class="btn btn-success">
            Descargar PDF de Trazabilidad
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle text-center">
            <thead class="table-dark text-white">
                <tr>
                    <th>Tipo de Evento</th>
                    <th>N° Orden</th>
                    <th>N° Mantenimiento</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Fin</th>
                    <th>Cliente</th>
                    <th>Manejado por</th>
                    <th>Tipo de Mantenimiento</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TipoEvento</td>

                        <td>@(item.OrderId.HasValue ? item.OrderId.Value.ToString() : "-")</td>
                        <td>@(item.MaintenanceId.HasValue ? item.MaintenanceId.Value.ToString() : "-")</td>

                        <td>
                            @(item.FechaInicio.HasValue
                                ? item.FechaInicio.Value.ToString("dd/MM/yyyy")
                                : "-")
                        </td>

                        <td>
                            @(
                                item.FechaFin.HasValue
                                    ? item.FechaFin.Value.ToString("dd/MM/yyyy")
                                    : item.FechaMantenimiento.HasValue
                                        ? item.FechaMantenimiento.Value.ToString("dd/MM/yyyy")
                                        : "-"
                            )
                        </td>

                        <td>
                            @(item.TipoEvento == "Préstamo"
                                ? (item.ClienteNombre ?? "-")
                                : "-")
                        </td>

                        <td>
                            @(
                                item.TipoEvento == "Préstamo"
                                    ? (item.EncargadoPrestamo ?? "-")
                                    : item.TipoEvento == "Mantenimiento"
                                        ? (item.Tecnico ?? "-")
                                        : "-"
                            )
                        </td>

                        <td>
                            @(
                                item.TipoEvento == "Mantenimiento"
                                    ? (
                                        item.TipoMantenimiento == 1 ? "Revisión por daño"
                                        : item.TipoMantenimiento == 2 ? "Reparación mayor"
                                        : item.TipoMantenimiento == 3 ? "Mantenimiento preventivo"
                                        : "—"
                                      )
                                    : "-"
                            )
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="pagination-container text-center mt-4">
            @Html.PagedListPager(
                Model,
                page => Url.Action("VerTrazabilidad",
                    new
                        {
                            equipoId = ViewBag.EquipoId,
                        page,
                        desde = ViewBag.FiltroDesde,
                        hasta = ViewBag.FiltroHasta
                    }),
                new PagedListRenderOptions
                    {
                    DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                    DisplayLinkToLastPage = PagedListDisplayMode.Always,
                    DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                    DisplayLinkToNextPage = PagedListDisplayMode.Always,
                    DisplayLinkToIndividualPages = true,
                    MaximumPageNumbersToDisplay = 10,
                    UlElementClasses = new[] { "pagination-custom" }
                }
            )
        </div>

        <style>
            .pagination-custom {
                display: flex;
                justify-content: center;
                gap: 12px;
                padding: 20px 0;
            }

                .pagination-custom li {
                    list-style: none;
                }

                    .pagination-custom li a,
                    .pagination-custom li span {
                        font-size: 18px;
                        color: black;
                        text-decoration: none;
                        padding: 4px 8px;
                    }

                    .pagination-custom li.active span {
                        font-weight: bold;
                    }

                    .pagination-custom li.disabled span {
                        color: #999;
                    }
        </style>

    </div>

    <div class="mt-4">
        <a href="@Url.Action("listarEquipment", "Equipment")" class="btn btn-secondary">
            Volver al Inventario
        </a>
    </div>
</div>
