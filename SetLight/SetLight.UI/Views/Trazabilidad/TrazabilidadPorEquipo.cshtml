@model List<SetLight.Abstracciones.ModelosParaUI.TrazabilidadDto>

@{
    ViewBag.Title = "Trazabilidad del Equipo";
}

<h2>Trazabilidad del Equipo @ViewBag.EquipoId</h2>

<a href="@Url.Action("DescargarTrazabilidad", "Trazabilidad", new { equipoId = ViewBag.EquipoId })" class="btn btn-info mb-3">
    Descargar PDF de Trazabilidad
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Tipo de Evento</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Persona</th>
            <th>Tipo de Mantenimiento</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TipoEvento</td>
                <td>@(item.FechaInicio.HasValue ? item.FechaInicio.Value.ToString("dd/MM/yyyy") : "-")</td>
                <td>
                    @(
                    item.FechaFin.HasValue
                        ? item.FechaFin.Value.ToString("dd/MM/yyyy")
                        : item.FechaMantenimiento.HasValue
                            ? item.FechaMantenimiento.Value.ToString("dd/MM/yyyy")
                            : "-"
                )
                </td>
                <td>@(item.ClienteNombre ?? item.Tecnico ?? "-")</td>
                <td>
                    @(
    item.TipoEvento == "Mantenimiento"
      ? (
          item.TipoMantenimiento == 1 ? "Revisión por daño"
        : item.TipoMantenimiento == 2 ? "Reparación mayor"
        : item.TipoMantenimiento == 3 ? "Mantenimiento preventivo"
        : "—"
        )
      : "-"
   )
                </td>

            </tr>
        }
    </tbody>

</table>

<a href="@Url.Action("listarEquipment", "Equipment")" class="btn btn-secondary">Volver al Inventario</a>
